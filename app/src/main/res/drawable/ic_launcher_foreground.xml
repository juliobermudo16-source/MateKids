<?xml version="1.0" encoding="utf-8"?>
<!--
    Capa frontal del icono adaptativo: "El Nucleo" rodeado de los cuatro
    simbolos de las operaciones. Todo el dibujo queda dentro de la zona
    segura central (radio 36 desde el centro del lienzo de 108x108).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Orbita -->
    <path
        android:pathData="M34,54 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.5" />

    <!-- Nucleo -->
    <path
        android:pathData="M42,54 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 z"
        android:fillColor="#FFFFFF" />

    <!-- Suma (arriba) -->
    <path
        android:pathData="M47,24 h14 v4 h-14 z M52,19 h4 v14 h-4 z"
        android:fillColor="#FFFFFF" />

    <!-- Resta (derecha) -->
    <path
        android:pathData="M75,52 h14 v4 h-14 z"
        android:fillColor="#FFFFFF" />

    <!-- Multiplicacion (abajo) -->
    <path
        android:pathData="M49,77 L59,87 M59,77 L49,87"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Division (izquierda) -->
    <path
        android:pathData="M19,52 h14 v4 h-14 z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M23.5,45.5 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M23.5,62.5 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 z"
        android:fillColor="#FFFFFF" />
</vector>
