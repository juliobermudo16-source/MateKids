<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <!-- Brain-like shape (circle with bumps) -->
    <circle
        android:cx="100"
        android:cy="100"
        android:r="70"
        android:fill="#8B5CF6" />
    <!-- Border -->
    <circle
        android:cx="100"
        android:cy="100"
        android:r="70"
        android:fill="none"
        android:stroke="#6D28D9"
        android:strokeWidth="3" />
    <!-- Thinking lines -->
    <circle
        android:cx="70"
        android:cy="70"
        android:r="8"
        android:fill="none"
        android:stroke="#FCD34D"
        android:strokeWidth="2" />
    <circle
        android:cx="130"
        android:cy="80"
        android:r="6"
        android:fill="none"
        android:stroke="#FCD34D"
        android:strokeWidth="2" />
    <circle
        android:cx="100"
        android:cy="120"
        android:r="5"
        android:fill="none"
        android:stroke="#FCD34D"
        android:strokeWidth="2" />
    <!-- Core glow -->
    <circle
        android:cx="100"
        android:cy="100"
        android:r="30"
        android:fill="#C084FC" />
</vector>
